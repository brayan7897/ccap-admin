# =============================================================================
# CCAP Admin — Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development, or configure these
# variables in your deployment platform (Vercel, Railway, etc.)
# =============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of the ccap-api backend (without trailing slash)
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api/v1

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Full URL where this admin app is deployed (no trailing slash)
NEXTAUTH_URL=https://your-admin-domain.com

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
